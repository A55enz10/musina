# Copiare in .env o usare scripts/setup-local.ps1; inserire valori locali.
MUSINA_DB_NAME=musina_dev
MUSINA_DB_USER=musina_dev
MUSINA_DB_PORT=15432
MUSINA_DB_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_SECRET
# Usati solo per il primo provisioning, se il database Musina e vuoto.
MUSINA_BOOTSTRAP_USERNAME=admin.local
MUSINA_BOOTSTRAP_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_SECRET
MUSINA_BOOTSTRAP_FAMILY=Famiglia
